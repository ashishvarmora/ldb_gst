# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values there.
#
#   cp .env.example .env.local
#
# .env.local is gitignored. THIS file is committed, so it must only ever
# contain placeholders. See docs/CREDENTIALS.md for where each value comes from.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase  (Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key, or sb_publishable_...>

# Server-only. Never expose to the browser. Used to create officer accounts,
# reset passwords and read cross-officer data in the admin panel.
SUPABASE_SERVICE_ROLE_KEY=<service_role key, or sb_secret_...>

# ---------------------------------------------------------------------------
# LDB (Logistics Data Bank) upstream - public endpoint, no key needed
# ---------------------------------------------------------------------------
LDB_API_URL=https://ldb.co.in/api/ldbv2/truck/search

# ---------------------------------------------------------------------------
# Telegram - ONE global bot for the whole platform. Officers only supply a
# chat id, so you never ask them to create a bot.
# Create with @BotFather, then paste the token here.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=<1234567890:AA...  from @BotFather>

# ---------------------------------------------------------------------------
# Google Sheets - ONE service account for the whole platform. Officers share
# their sheet with the service-account email below (Editor) and paste the URL.
# Keep the private key on ONE line with literal \n, wrapped in double quotes.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=gst-truck-sync@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Secret shared with the tracking cron. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
CRON_SECRET=<a long random string>

# ---------------------------------------------------------------------------
# Razorpay (OPTIONAL - only needed if officers buy their own credits)
#
# Dashboard -> Settings -> API Keys. The key id is public and also goes in
# NEXT_PUBLIC_RAZORPAY_KEY_ID so checkout can open in the browser. The two
# secrets stay server-side: they are the only reason a payment cannot be
# forged by whoever is sitting in front of the page.
#
# The webhook secret is set when you add the webhook in Razorpay:
#   Dashboard -> Settings -> Webhooks -> Add New Webhook
#   URL     https://<your-domain>/api/webhooks/razorpay
#   Events  payment.captured, payment.failed
#
# Switching payments on in Admin -> Settings does nothing until these exist.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=<from the same screen - never commit this>
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=<the secret you typed when creating the webhook>

# ---------------------------------------------------------------------------
# Email (REQUIRED for password reset)
#
# Resend: https://resend.com -> API Keys. The from address has to be on a
# domain you have verified with them, or every send is rejected.
#
# Without these, sign-in and sign-up still work - only the 'forgot password'
# flow has no way to reach anyone.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Truck Watch <no-reply@your-domain.com>"

# ---------------------------------------------------------------------------
# Public site address (OPTIONAL)
#
# Where password-reset links point. Vercel supplies its own host, so this is
# only needed for a custom domain or local testing. No trailing slash.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Database connection (OPTIONAL, local only)
# Read by scripts/push-migrations.mjs. Never needed by the app, never on Vercel.
# Supabase -> Project Settings -> Database -> Connection string -> URI
# ---------------------------------------------------------------------------
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Bootstrap admin (OPTIONAL, local only)
# Read by scripts/bootstrap-admin.mjs so your password never lands in shell
# history. Run the script once, sign in, then delete these three lines.
# Do NOT add them to Vercel - the deployed app never reads them.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=<at least 8 characters>
ADMIN_NAME=Your Name
