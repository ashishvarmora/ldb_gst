<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Driver links https://rahdari.in/d/<token> open in the app when it is
                 installed, so location sharing can continue in the background.
                 autoVerify needs public/.well-known/assetlinks.json on rahdari.in with
                 the release (and Play app-signing) SHA-256; until that is right the
                 link is simply unverified: Android then opens it in the browser, and
                 the driver can still pick Rahdari via Settings > Apps > Rahdari >
                 Open by default (or an "Open with" prompt on older Android). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="rahdari.in" android:pathPrefix="/d/" />
            </intent-filter>
        </activity>

        <!-- Push notifications (Firebase Cloud Messaging). The channel id matches the
             one src/lib/fcm.ts sends to and the page creates on first sign-up;
             without these meta-data entries the push plugin also cannot show a
             notification that arrives while the app is open. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="alerts" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <!-- v7 driver location sharing that keeps running with the screen off, after the app is
             swiped away (stopWithTask=false) and after a reboot (BootReceiver). See tracker/TrackerService. -->
        <service
            android:name=".tracker.TrackerService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />
        <receiver
            android:name=".tracker.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ asks before showing notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Driver location sharing in the background (@capacitor-community/background-geolocation:
         a foreground service of type "location" with an ongoing notification). The plugin
         merges the same entries; they are listed here so the policy-relevant set is visible.
         ACCESS_BACKGROUND_LOCATION is declared at the owner's request; the foreground-service
         design does not strictly need it (see mobile/README.md). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- v7: restart sharing after a reboot, and ask once for "battery: unrestricted". -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Saving exports to Downloads needs this only on Android 9 and older. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Android 11+ hides other apps unless declared: lets UPI and Telegram links find their apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
